PORT=3000
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=300

# Number of reverse proxies in front of the app (0 = none). Set it behind a proxy so the
# rate limiter sees the real client address. Never set it when clients reach the app directly.
TRUST_PROXY=0

PARTNER_API_KEY=replace-with-a-long-random-value

# Optional model wording for plan steps. Off by default; the plan is complete without it.
# The endpoint must accept the chat completions request format. The key stays on the server.
PLAN_WORDING_ENABLED=false
PLAN_WORDING_URL=
PLAN_WORDING_KEY=
PLAN_WORDING_MODEL=

# Directory with the built frontend. Served on the same origin when it exists.
# Defaults to ../frontend/dist relative to the repository root.
STATIC_DIR=
